#!/bin/sh
# Sessão do jogador no tty1 (TV): atualiza as listas de jogos e mantém o RetroArch aberto.
#   Menu principal > "Desligar"            => desliga o aparelho com segurança.
#   Menu principal > "Reiniciar"           => reinicia (o RetroArch cria /tmp/stv-reiniciar).
#   Se o RetroArch travar/fechar com erro  => reabre sozinho.
#   Jogos copiados pela rede (\\STV2000\JOGOS) entram nas listas em até 15 s; se o
#   aparelho ligou sem nenhum jogo, o RetroArch reabre sozinho para mostrar as abas.
# Para usar só o terminal: crie ~/.sem-autostart (ex.: via SSH) e reinicie.
[ "$(tty)" = /dev/tty1 ] || exit 0
if [ -e "$HOME/.sem-autostart" ]; then
    echo "RetroArch automático desativado (apague ~/.sem-autostart para voltar)."
    exit 0
fi

LOG="$HOME/.cache/retroarch.log"
PL="$HOME/.config/retroarch/playlists"
mkdir -p "$HOME/.cache"
# Na TV só aparecem imagens (stv-tela), nunca o texto do console. Mensagens de erro
# vão para o log; o texto só aparece se o RetroArch falhar várias vezes seguidas.
exec 2>>"$HOME/.cache/stv-session.log"

# Em segundo plano, com o RetroArch aberto: atualiza as listas (stv-playlists só regrava
# quando algo muda em JOGOS\roms). O RetroArch relê a lista ao entrar na aba, mas só monta
# as abas ao abrir: se ele abriu sem nenhum sistema, a primeira lista o faz reabrir.
atualizar_listas() {
    vazio=$1
    while sleep 15; do
        # sem mudanças ele não imprime nada: só grava o log quando regerou as listas
        saida=$(nice -n 19 /usr/local/bin/stv-playlists 2>&1)
        [ -z "$saida" ] || printf '%s\n' "$saida" > "$HOME/.cache/playlists.log"
        if [ "$vazio" = 1 ] && ls "$PL"/*.lpl >/dev/null 2>&1; then
            touch /tmp/stv-recarregar
            pkill -TERM -x retroarch
            return
        fi
    done
}

falhas=0
while :; do
    rm -f /tmp/stv-reiniciar /tmp/stv-recarregar
    stv-tela iniciando
    /usr/local/bin/stv-playlists > "$HOME/.cache/playlists.log" 2>&1
    if [ "$falhas" -eq 0 ] && ! ls "$PL"/*.lpl >/dev/null 2>&1; then
        stv-tela sem-jogos
        read -rs -t 20 _ || true   # Enter no teclado pula a espera
    fi
    /etc/local.d/20-audio.start >/dev/null 2>&1   # a placa de som pode subir depois do boot
    vazio=0; ls "$PL"/*.lpl >/dev/null 2>&1 || vazio=1
    atualizar_listas "$vazio" &
    atualizador=$!
    retroarch > "$LOG" 2>&1
    rc=$?
    kill "$atualizador" 2>/dev/null
    if [ -e /tmp/stv-recarregar ]; then   # chegaram jogos: só reabre o RetroArch
        falhas=0
        continue
    fi
    if [ "$rc" -eq 0 ]; then
        sync
        if [ -e /tmp/stv-reiniciar ]; then
            stv-tela reiniciando
            doas /sbin/reboot || echo "$(date): doas reboot falhou" >&2
        else
            stv-tela desligando
            doas /sbin/poweroff || echo "$(date): doas poweroff falhou" >&2
        fi
        sleep 60
    fi
    falhas=$((falhas + 1))
    if [ "$falhas" -ge 5 ]; then
        clear
        printf '\033[?25h'
        echo "O RetroArch fechou com erro $falhas vezes seguidas (código $rc)."
        echo "Últimas linhas de $LOG:"
        tail -n 15 "$LOG"
        echo
        echo "Enter = tentar de novo.  (Ou acesse por SSH: ssh $(id -un)@$(hostname))"
        read -r _
        falhas=0
        printf '\033[?25l'
    else
        sleep 2
    fi
done
