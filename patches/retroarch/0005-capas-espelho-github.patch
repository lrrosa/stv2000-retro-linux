+/* STV-2000: se o download que acabou de terminar falhou, tenta o mesmo
+ * arquivo uma vez no espelho do GitHub. Roda no handler da tarefa (mesma
+ * thread de download_pl_thumbnail), nunca no callback do HTTP.
+ * Retorna true se iniciou uma nova transferência. */
+static bool stv_try_mirror(pl_thumb_handle_t *pl_thumb)
+{
+   char url[2048];
+   file_transfer_t *transf = NULL;
+   bool failed             = (pl_thumb->flags & PL_THUMB_FLAG_STV_FAILED) != 0;
+
+   pl_thumb->flags        &= ~PL_THUMB_FLAG_STV_FAILED;
+
+   if (     !failed
+         || string_is_empty(pl_thumb->stv_mirror_url)
+         || string_is_empty(pl_thumb->stv_mirror_path))
+      return false;
+
+   strlcpy(url, pl_thumb->stv_mirror_url, sizeof(url));
+   pl_thumb->stv_mirror_url[0] = '\0'; /* uma tentativa só */
+
+   if (!(transf = (file_transfer_t*)malloc(sizeof(file_transfer_t))))
+      return false;
+
+   transf->enum_idx  = MSG_UNKNOWN;
+   transf->user_data = (void*)pl_thumb;
+   strlcpy(transf->path, pl_thumb->stv_mirror_path, sizeof(transf->path));
+
+   RARCH_LOG("[Thumbnail] Trying mirror \"%s\".\n", url);
+
+   pl_thumb->flags  &= ~PL_THUMB_FLAG_HTTP_TASK_COMPLETE;
+   /* Se não der para enfileirar, o callback não é chamado nem libera transf */
+   if (!(pl_thumb->http_task = (retro_task_t*)task_push_http_transfer_file(
+         url, true, NULL, cb_http_task_download_pl_thumbnail, transf)))
+   {
+      pl_thumb->flags |= PL_THUMB_FLAG_HTTP_TASK_COMPLETE;
+      free(transf);
+      return false;
+   }
+   return true;
+}
