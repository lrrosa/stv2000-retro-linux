# Boot do STV-2000 pelo U-Boot mainline (u-boot.ext), carregado pelo U-Boot de fábrica.
# Para ver o texto do boot na TV: acrescente " console=tty0" no fim da linha APPEND.
DEFAULT alpine
TIMEOUT 10

LABEL alpine
  MENU LABEL Alpine Linux STV-2000
  LINUX /Image
  INITRD /initramfs-lts
  FDT /dtbs-lts/@DTB@
  APPEND @CMDLINE@
